{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PostRunCheck",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Build-PostRunCheck.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run PostRunCheck",
      "type": "process",
      "command": "${workspaceFolder}\\dist\\PostRunCheck.exe",
      "dependsOn": "Build PostRunCheck",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
