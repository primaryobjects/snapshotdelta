{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SnapshotDelta",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Build-SnapshotDelta.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run SnapshotDelta",
      "type": "process",
      "command": "${workspaceFolder}\\dist\\SnapshotDelta.exe",
      "dependsOn": "Build SnapshotDelta",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
